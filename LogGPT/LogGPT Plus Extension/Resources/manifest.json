{
  "manifest_version": 3,
  "name": "LogGPT Plus",
  "author": "Distributed Thinking Systems LLC",
  "version": "1.3.0",
  "description": "Archive ChatGPT conversations with generated and uploaded artifacts.",
  "icons": {
    "16": "icons/Icon-16.png",
    "32": "icons/Icon-32.png",
    "48": "icons/Icon-48.png",
    "96": "icons/Icon-96.png",
    "128": "icons/Icon-128.png"
  },
  "web_accessible_resources": [{
    "resources": ["icons/download-icon.svg", "icons/download-icon.png"],
    "matches": ["<all_urls>"]
  }],
  "content_scripts": [{
    "matches": ["*://chatgpt.com/*"],
    "js": ["icon.js", "LogGPT-conv-export.js"]
  }],
  "host_permissions": ["*://chatgpt.com/*"],
  "permissions": ["downloads", "nativeMessaging", "storage"],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_popup": "options.html",
    "default_icon": {
      "16": "icons/Icon-16.png",
      "32": "icons/Icon-32.png",
      "48": "icons/Icon-48.png"
    }
  }
}
