{
    "manifest_version": 2,
    "name": "LogGPT",
    "author": "Distributed Thinking Systems, LLC",
    "version": "1.3.1",
    "description": "Export ChatGPT conversations as JSON. Optional Plus upgrade archives generated and uploaded artifacts.",

    "icons": {
      "16": "icons/Icon-16.png",
      "32": "icons/Icon-32.png",
      "48": "icons/Icon-48.png",
      "96": "icons/Icon-96.png",
      "128": "icons/Icon-128.png"
    },

    "web_accessible_resources": [

      "icons/download-icon.png",
      "icons/plus/download-icon.png",
      "icons/Icon-32.png",
      "icons/Icon-48.png"
    ],

    "content_scripts": [
      {
        "matches": ["*://chatgpt.com/*"],
        "js": [
          "icon.js",
          "LogGPT-conv-export.js"
        ],
        "run_at": "document_idle"
      }
    ],

    "permissions": [
      "downloads",
      "nativeMessaging",
      "storage"
    ],

    "background": {
      "scripts": ["background.js"]
    },

    "options_ui": {
      "page": "options.html",
      "open_in_tab": false
    },

    "browser_action": {
      "default_popup": "options.html",
      "default_icon": {
        "16": "icons/Icon-16.png",
        "32": "icons/Icon-32.png",
        "48": "icons/Icon-48.png"
      }
    }
  }
