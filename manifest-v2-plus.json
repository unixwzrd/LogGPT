{
  "manifest_version": 2,
  "name": "LogGPT Plus",
  "author": "Distributed Thinking Systems, LLC",
  "version": "1.2.1",
  "description": "LogGPT Plus: Export ChatGPT conversation JSON logs and optional media bundles.",
  "icons": {
    "16": "icons/Icon-16.png",
    "32": "icons/Icon-32.png",
    "48": "icons/Icon-48.png",
    "96": "icons/Icon-96.png",
    "128": "icons/Icon-128.png"
  },
  "web_accessible_resources": [
    "icons/download-icon.png",
    "icons/Icon-32.png",
    "icons/Icon-48.png"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://chatgpt.com/*"
      ],
      "js": [
        "icon.js",
        "LogGPT-conv-export.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "*://chatgpt.com/*",
    "downloads",
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "browser_action": {
    "default_popup": "options.html",
    "default_icon": {
      "16": "icons/Icon-16.png",
      "32": "icons/Icon-32.png",
      "48": "icons/Icon-48.png"
    }
  }
}
